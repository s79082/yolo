# ============================================================
#  Bilder: AUSSCHLIESSLICH unterhalb von /paper erlaubt
# ============================================================
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
*.gif
*.GIF
*.bmp
*.BMP
*.tif
*.tiff
*.TIF
*.TIFF
*.webp
*.WEBP
*.heic
*.HEIC
*.ico

# Ausnahme: Abbildungen der Arbeit
!paper/**/*.jpg
!paper/**/*.jpeg
!paper/**/*.png

# Ausnahme: Quellmaterial fuer Training und Auswertung (die Bewertungsbilder
# stehen weiter unten bei data/).  assets/ (Masken, Okkluder) und synth/
# lassen sich daraus mit src/matting.py, src/occluders.py und
# src/generate.py neu erzeugen.
!cutouts/*.png
!bg/*.jpg
!bg/*.png

# ============================================================
#  Kompilierte PDFs (Build-Artefakte)
# ============================================================
*.pdf

# ============================================================
#  Python
# ============================================================
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ============================================================
#  Modellgewichte (mehrere hundert MB, nicht versionierbar)
# ============================================================
*.pt
*.pth
*.onnx

# ============================================================
#  Generierte Datensaetze / Trainingsdaten
# ============================================================
synth/
data/sval/
data/*/images/*
!data/val/images/*.jpg
!data/test/images/*.jpg
*.cache

# ============================================================
#  Trainingslaeufe: Metriken bleiben, Gewichte/Plots nicht
# ============================================================
runs/**/weights/
cnn/runs/**/weights/

# ============================================================
#  Logs
# ============================================================
*.log

# ============================================================
#  Sonstiges
# ============================================================
.DS_Store
