# ============================================================
#  Bilder: AUSSCHLIESSLICH unterhalb von /paper erlaubt
# ============================================================
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
*.gif
*.GIF
*.bmp
*.BMP
*.tif
*.tiff
*.TIF
*.TIFF
*.webp
*.WEBP
*.heic
*.HEIC
*.ico

# Ausnahme: Abbildungen der Arbeit
!paper/**/*.jpg
!paper/**/*.jpeg
!paper/**/*.png

# Ausnahme: Quellmaterial fuer Training und Auswertung (die Bewertungsbilder
# stehen weiter unten bei data/).  synth/ laesst sich daraus mit
# src/generate.py neu erzeugen.  Masken und Okkluder sind eingecheckt, weil
# src/matting.py die Masken unter anderen Bibliotheksversionen nicht
# bitgleich reproduziert; IMG_3884/IMG_3886 sind die Quellen von
# src/clean_plates.py.
!cutouts/*.png
!bg/*.jpg
!bg/*.png
!assets/masks/*.png
!assets/bars/*.png
!/IMG_3884.JPG
!/IMG_3886.JPG

# ============================================================
#  Kompilierte PDFs (Build-Artefakte)
# ============================================================
*.pdf

# ============================================================
#  Python
# ============================================================
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ============================================================
#  Modellgewichte (mehrere hundert MB, nicht versionierbar)
# ============================================================
*.pt
*.pth
*.onnx

# ============================================================
#  Generierte Datensaetze / Trainingsdaten
# ============================================================
synth/
data/sval/
data/*/images/*
!data/val/images/*.jpg
!data/test/images/*.jpg
*.cache

# ============================================================
#  Trainingslaeufe: Metriken bleiben, Gewichte/Plots nicht
# ============================================================
runs/**/weights/
cnn/runs/**/weights/

# ============================================================
#  Logs
# ============================================================
*.log

# ============================================================
#  Sonstiges
# ============================================================
.DS_Store
